# Copy this file to `keystore.properties` and fill in the real values.
# `keystore.properties` is git-ignored by default — never commit your keys.
#
# Generate a keystore locally with:
#   keytool -genkey -v -keystore political-ascent.jks \
#       -keyalg RSA -keysize 2048 -validity 10000 \
#       -alias political-ascent

storeFile=../political-ascent.jks
storePassword=CHANGE_ME
keyAlias=political-ascent
keyPassword=CHANGE_ME
