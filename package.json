{
  "name": "political-ascent",
  "version": "0.1.0-alpha.1-exp.20260429",
  "description": "Political Ascent — a hybrid RPG / grand strategy / political simulation game.",
  "author": "Political Ascent Team",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:electron": "cross-env VITE_TARGET=electron NODE_ENV=development vite",
    "build": "npm run build:web",
    "build:web": "tsc -p tsconfig.web.build.json && vite build",
    "build:electron:bundle": "cross-env VITE_TARGET=electron tsc -p tsconfig.electron.json && cross-env VITE_TARGET=electron vite build",
    "build:electron:package": "electron-builder",
    "build:electron": "npm run build:electron:bundle && npm run build:electron:package",
    "build:electron:ci": "npm run build:electron:bundle && electron-builder --linux --dir",
    "build:win": "npm run build:electron:bundle && electron-builder --win",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.web.build.json && tsc --noEmit -p tsconfig.electron.json",
    "cap:sync": "cap sync android",
    "cap:open:android": "cap open android",
    "android:assemble": "cd android && gradlew.bat assembleDebug",
    "android:build": "npm run build:web && npm run cap:sync && npm run android:assemble",
    "android:release": "cd android && gradlew.bat assembleRelease",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update": "playwright test --update-snapshots"
  },
  "engines": {
    "node": ">=20.0.0 <21"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "immer": "^10.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.1",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.4.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "electron": "^32.0.2",
    "electron-builder": "^26.8.1",
    "electron-store": "^10.0.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.35.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.13",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "vite-plugin-electron": "^0.29.1",
    "vitest": "^2.0.5"
  }
}
